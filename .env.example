# Stub server settings (all optional; defaults work offline)
STUB_MODEL_ID=stub-model
STUB_HOST=0.0.0.0
STUB_PORT=8000
# Artificial delay in milliseconds (0 = none). Useful for latency demos.
STUB_LATENCY_MS=0

# Fault injection (off by default). Spec: 429[:retry_after_s] | 503[:retry_after_s] | timeout[:ms] | drop[:k] | none
# Per-request alternatives: header `X-Stub-Fault: 429:2` or model suffix `stub-model::fault=503`.
STUB_FAULT=
# Optional deterministic schedule for STUB_FAULT (neither set = every request):
# STUB_FAULT_FIRST=2     # only the first N chat requests
# STUB_FAULT_EVERY=3     # every Nth chat request
# STUB_FAULT_TIMEOUT_MS=30000
# Synthetic x-ratelimit-* header limits (reported, never enforced)
# STUB_RATELIMIT_REQUESTS=60
# STUB_RATELIMIT_TOKENS=100000
